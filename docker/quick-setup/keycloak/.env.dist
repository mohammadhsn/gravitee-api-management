# ─────────────────────────────────────────────────────────────────────────────
# Public address of the host running this stack.
# Local dev: leave as localhost.
# On a VM: set PUBLIC_HOST to the machine's public IP (or DNS name).
# Every browser-facing URL is built from these two values, so the same compose
# file works locally and on a remote VM with no further edits.
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http

# Host ports published for the browser-facing services. Change if a port is
# already taken on the VM; the container-side ports never change.
# KC_PORT=Keycloak  GW_PORT=Gateway  API_PORT=Management API
# CONSOLE_PORT=Console UI  PORTAL_PORT=Developer Portal UI
KC_PORT=8080
GW_PORT=8082
API_PORT=8083
CONSOLE_PORT=8084
PORTAL_PORT=8085

# Pinned APIM image version (matches the :-4.11.6 default in the compose file).
APIM_VERSION=4.11.6

# Kibana (ELK phase 1)
KIBANA_VERSION=8.17.2
KIBANA_PORT=5601

# Logstash + Filebeat (ELK phase 2)
LOGSTASH_VERSION=8.17.2
FILEBEAT_VERSION=8.17.2
