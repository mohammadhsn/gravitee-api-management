# ─────────────────────────────────────────────────────────────────────────────
# Public origin — the single browser-facing base URL, served by the edge nginx.
# Every service URL is derived from it (/auth, /console, /devportal, /management,
# /portal, /kibana, /grafana, /prometheus, and the gateway at /).
#   Local:  http://localhost
#   VM:     http://<public-ip>   (or https://<dns-host> behind TLS)
# Add :port only if EDGE_PORT differs from 80.
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://localhost

# Host port the edge nginx publishes — the ONLY port exposed to the outside.
EDGE_PORT=443
# Plain-HTTP listener; only 301-redirects to the HTTPS edge above.
EDGE_PORT_HTTP=80

# ----- Pinned image versions -----
APIM_VERSION=4.11.6
KIBANA_VERSION=8.17.2
LOGSTASH_VERSION=8.17.2
FILEBEAT_VERSION=8.17.2
PROMETHEUS_VERSION=v2.53.2
GRAFANA_VERSION=11.3.1
