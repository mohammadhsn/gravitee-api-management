        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(http_client_response_time_seconds_sum{job=~\"$job\"}[5m])/clamp_min(rate(http_client_response_time_seconds_count{job=~\"$job\"}[5m]),1)",
          "legendFormat": "avg {{job}}",
          "refId": "A"
        }
